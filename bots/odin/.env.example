# Copy to .env (gitignored). Values from https://discord.com/developers/applications
DISCORD_APP_ID=000000000000000000
DISCORD_PUBLIC_KEY=replace_with_public_key_hex
DISCORD_BOT_TOKEN=replace_with_bot_token
DISCORD_DEV_GUILD_ID=000000000000000000

# Server
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
DEFAULT_LOCALE=en-US

# Odin
ODIN_MOD_CHANNEL_ID=                    # channel for reports / moderation notices (required for "Report message")
# ODIN_REPORTS_DIR=bots/odin/reports    # JSONL moderation log location (default: bot's reports/)
# ODIN_HISTORY_LIMIT=10                 # entries shown by "View history" (1–25)
