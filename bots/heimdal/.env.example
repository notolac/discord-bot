# Copy to .env (gitignored). Values from https://discord.com/developers/applications
DISCORD_APP_ID=000000000000000000
DISCORD_PUBLIC_KEY=replace_with_public_key_hex
DISCORD_BOT_TOKEN=replace_with_bot_token
DISCORD_DEV_GUILD_ID=000000000000000000
DISCORD_PROD_GUILD_ID=000000000000000000   # production guild; pass --guild (never implicit default)

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEFAULT_LOCALE=en-US

# Heimdal — member (self-serve) + claimed roles (staff approval)
HEIMDAL_MEMBER_ROLE_ID=                 # only role granted by the rules-accept button
HEIMDAL_INTEREST_ROLES=                 # cosmetic /roles only, e.g. "Academia:123" (max 25)
HEIMDAL_RULES_URL=                      # link button next to "I accept the rules"
HEIMDAL_INTRO_CHANNEL_ID=               # where /introduce cards are posted
HEIMDAL_APPROVAL_CHANNEL_ID=            # staff channel for Approve/Deny cards
HEIMDAL_APPROVER_ROLE_IDS=              # "adminId,moderatorId" — may click Approve/Deny
HEIMDAL_ORGANIZER_ROLE_ID=              # approval-only
HEIMDAL_SPEAKER_ROLE_ID=                # approval-only
HEIMDAL_STARTUPS_ROLE_ID=               # approval-only (not in /roles)
HEIMDAL_ENTERPRISES_ROLE_ID=            # approval-only (not in /roles)
HEIMDAL_DENIED_ROLE_IDS=                # never grant: "adminId,moderatorId,heimdalId,odinId"
