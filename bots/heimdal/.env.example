# Copy to .env (gitignored). Values from https://discord.com/developers/applications
DISCORD_APP_ID=000000000000000000
DISCORD_PUBLIC_KEY=replace_with_public_key_hex
DISCORD_BOT_TOKEN=replace_with_bot_token
DISCORD_DEV_GUILD_ID=000000000000000000
DISCORD_PROD_GUILD_ID=000000000000000000   # production guild; pass --guild (never implicit default)

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEFAULT_LOCALE=en-US

# Heimdal
HEIMDAL_MEMBER_ROLE_ID=                 # role granted after accepting the rules (optional)
HEIMDAL_INTEREST_ROLES=                 # "Gaming:123456789,Dev:987654321" (optional, max 25)
HEIMDAL_RULES_URL=                      # link button next to "I accept the rules" (optional)
HEIMDAL_INTRO_CHANNEL_ID=               # where /introduce cards are posted (optional)
