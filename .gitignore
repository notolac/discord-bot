# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Runtime output (keep placeholders)
**/logs/*
!**/logs/.gitkeep
**/reports/*
!**/reports/.gitkeep
!**/reports/README.md

# Official docs cache (regenerable via the discord-docs skill script)
docs/discord/

# Agent skill install targets (created by Skills/install_skills.sh)
Skills/*/.install-manifest
.cursor/skills/
.github/skills/
.opencode/skills/
.opencode/commands/
.claude/skills/
.agents/skills/

# Python / uv
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
